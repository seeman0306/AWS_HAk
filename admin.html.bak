<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CivicEye AI — Admin Command Center</title>
  <link rel="stylesheet" href="styles.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>
</head>
<body data-page="admin" data-role="admin" class="app-layout">

<nav class="topnav">
  <button onclick="document.getElementById('leftNavSidebar').classList.add('open')" style="background:none; border:none; cursor:pointer; font-size:1.5rem; margin-right:16px; color:var(--gray-700);">☰</button>
  <a href="index.html" class="topnav-brand">
    <img src="assets/Gemini_Generated_Image_gdz2abgdz2abgdz2.png" alt="Logo" class="topnav-icon" style="background:none; box-shadow:none; padding:0; object-fit:contain; border-radius:0;" />
    <div>
      <div class="topnav-brand-text">CivicEye AI</div>
      <div class="topnav-brand-sub">Admin Command Center</div>
    </div>
  </a>
  <div class="topnav-sep"></div>
  <div class="topnav-actions">
    <div style="display:flex; gap:16px; margin-right:16px; align-items:center; font-size:0.9rem; font-weight:600; color:var(--gray-600);">
      <a href="#" onclick="showMainAdminPage(); return false;" style="color:var(--brand-600);">Dashboard</a>
      <a href="#" onclick="logout(); return false;">Logout</a>
    </div>
    <span class="role-badge admin">‍ Overall Admin</span>
  </div>
</nav>

<div id="mainAdminPage" class="page-content">

  <!-- Page Title Banner -->
  <div style="background:linear-gradient(135deg,#0f172a,#4c1d95,#7c3aed); border-radius:var(--radius-xl); padding:28px 32px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;">
    <div>
      <div style="font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; color:rgba(255,255,255,0.5); margin-bottom:6px;">Overall Municipal Control</div>
      <h1 style="font-size:1.75rem; font-weight:900; color:white; letter-spacing:-0.02em; margin-bottom:6px;">️ Admin Command Center</h1>
      <p style="color:rgba(255,255,255,0.65); font-size:0.9rem;">Cross-departmental oversight &amp; automated dispatch telemetry</p>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
      <span style="background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15); color:rgba(255,255,255,0.85); padding:6px 14px; border-radius:var(--radius-full); font-size:0.78rem; font-weight:600;">Full Municipal Visibility</span>
    </div>
  </div>

  <!-- KPI Grid — Top Level Stats -->
  <div class="kpi-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom:14px;">
    <div class="kpi-card kpi-violet">
      <div class="kpi-icon"></div>
      <div class="kpi-label">Total Complaints</div>
      <div id="adminTotalCount" class="kpi-value">0</div>
    </div>
    <div class="kpi-card kpi-blue">
      <div class="kpi-icon">️</div>
      <div class="kpi-label">Road Issues</div>
      <div id="adminRoadCount" class="kpi-value" style="color:var(--road-primary);">0</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon"></div>
      <div class="kpi-label">Street Light Issues</div>
      <div id="adminStreetCount" class="kpi-value" style="color:var(--street-primary);">0</div>
    </div>
    <div class="kpi-card kpi-red">
      <div class="kpi-icon"></div>
      <div class="kpi-label">Traffic Issues</div>
      <div id="adminTrafficCount" class="kpi-value" style="color:var(--traffic-primary);">0</div>
    </div>
  </div>

  <div class="kpi-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom:24px;">
    <div class="kpi-card kpi-blue">
      <div class="kpi-icon">🆕</div>
      <div class="kpi-label">Pending Dispatch</div>
      <div id="adminNewCount" class="kpi-value" style="color:var(--brand-600);">0</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">️</div>
      <div class="kpi-label">Field In Progress</div>
      <div id="adminProgressCount" class="kpi-value" style="color:var(--warning);">0</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon"></div>
      <div class="kpi-label">Resolved</div>
      <div id="adminResolvedCount" class="kpi-value" style="color:var(--success);">0</div>
    </div>
  </div>


  <!-- Interactive City Map -->
  <div class="card mb-6">
    <div class="card-header">
      <div>
        <h3> City Incident Live Map</h3>
        <div style="font-size:0.78rem; color:var(--gray-500); margin-top:2px;">
          Color-coded pins:  Road &nbsp;|&nbsp; 🟡 Street Light &nbsp;|&nbsp;  Traffic — Click any marker for telemetry
        </div>
      </div>
    </div>
    <div class="card-body" style="padding:0; overflow:hidden; border-radius:0 0 var(--radius-xl) var(--radius-xl);">
      <div class="map-wrapper" style="border-radius:0; border:none;">
        <div id="adminMap"></div>
      </div>
    </div>
  </div>

  <!-- Complaints Master Registry -->
  <div class="card">
    <div class="card-header">
      <h3> Master Complaints Registry</h3>
      <span style="font-size:0.78rem; color:var(--gray-500);">Audit log with filters</span>
    </div>
    <div class="card-body">
      <div class="table-filters">
        <input type="text" id="adminSearch" class="search-field" placeholder=" Search by ID, issue, or address..." />
        <select id="filterDept" class="filter-select">
          <option value="ALL">All Departments</option>
          <option value="ROAD">Road Department</option>
          <option value="STREET_LIGHT">Street Light Dept</option>
          <option value="TRAFFIC">Traffic Department</option>
        </select>
        <select id="filterStatus" class="filter-select">
          <option value="ALL">All Statuses</option>
          <option value="NEW">NEW</option>
          <option value="IN PROGRESS">IN PROGRESS</option>
          <option value="RESOLVED">RESOLVED</option>
        </select>
        <select id="filterSeverity" class="filter-select">
          <option value="ALL">All Severities</option>
          <option value="HIGH">HIGH</option>
          <option value="MEDIUM">MEDIUM</option>
          <option value="LOW">LOW</option>
        </select>
      </div>

      <div class="data-table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Issue</th>
              <th>Department</th>
              <th>Severity</th>
              <th>Location</th>
              <th>Status</th>
              <th>Date</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="adminTableBody">
            <tr><td colspan="8" class="text-center text-muted" style="padding:24px;">Loading records...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Department Details Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 24px; margin-bottom: 40px;">
    <div class="card" style="border-top: 4px solid #2563eb; padding: 24px; border-radius: var(--radius-xl);">
      <h3 style="color: #2563eb; margin-bottom: 8px; font-size: 1.1rem; font-weight: 700;">Road Department</h3>
      <div style="font-size: 0.85rem; color: var(--gray-500); margin-bottom: 16px;">Officer: R. Sharma</div>
      <p style="font-size: 0.9rem; color: var(--gray-600); line-height: 1.5; margin: 0;">Handles potholes, asphalt cracking & road edge erosion with automated repair dispatch.</p>
    </div>
    
    <div class="card" style="border-top: 4px solid #d97706; padding: 24px; border-radius: var(--radius-xl);">
      <h3 style="color: #d97706; margin-bottom: 8px; font-size: 1.1rem; font-weight: 700;">Street Light Dept</h3>
      <div style="font-size: 0.85rem; color: var(--gray-500); margin-bottom: 16px;">Officer: V. Nathan</div>
      <p style="font-size: 0.9rem; color: var(--gray-600); line-height: 1.5; margin: 0;">Monitors luminaire inoperative statuses, feeder circuits, & night-time dark corridors.</p>
    </div>
    
    <div class="card" style="border-top: 4px solid #dc2626; padding: 24px; border-radius: var(--radius-xl);">
      <h3 style="color: #dc2626; margin-bottom: 8px; font-size: 1.1rem; font-weight: 700;">Traffic Department</h3>
      <div style="font-size: 0.85rem; color: var(--gray-500); margin-bottom: 16px;">Officer: K. Selvan</div>
      <p style="font-size: 0.9rem; color: var(--gray-600); line-height: 1.5; margin: 0;">Tracks AI vehicle counts, congestion bottlenecks, flyover queues & signal timings.</p>
    </div>
  </div>

</div>

<!-- Left Navigation Sidebar -->
<div id="leftNavSidebar" class="analytics-sidebar left-sidebar">
  <div class="analytics-header">
    <h2>Dashboard Menu</h2>
    <button onclick="document.getElementById('leftNavSidebar').classList.remove('open')" class="btn-ghost" style="padding:4px 8px; font-size:1.2rem; cursor:pointer;">&times;</button>
  </div>
  <div class="analytics-body" style="padding: 16px;">
    <button onclick="openAnalyticsModal('overview')" class="btn-primary" style="width:100%; margin-bottom:16px; justify-content:flex-start; padding: 12px 16px; background:var(--brand-600); border:none;">
      📊 Overview Analytics
    </button>
    <button onclick="openAnalyticsModal('department')" class="btn-primary" style="width:100%; justify-content:flex-start; padding: 12px 16px; background:var(--gray-800); border:none;">
      🏢 Department-wise Analysis
    </button>
  </div>
</div>

<!-- Analytics Page (Hidden by default) -->
<div id="analyticsPage" class="page-content" style="display:none;">
  <!-- Page Title Banner -->
  <div style="background:linear-gradient(135deg,#0f172a,#4c1d95,#7c3aed); border-radius:var(--radius-xl); padding:28px 32px; margin-bottom:24px; display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap;">
    <div>
      <h2 id="analyticsPageTitle" style="color:white; font-size:1.5rem; margin-bottom:8px; font-weight:800;">Analytics</h2>
      <p style="color:var(--gray-300); font-size:0.9rem; margin:0;">Comprehensive platform statistics</p>
    </div>
  </div>

  <!-- Overview View -->
  <div id="analyticsOverviewView" style="display:none; background:white; padding:24px; border-radius:var(--radius-xl); box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:24px; margin-bottom: 40px;">
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none;"><div style="font-size:0.85rem; color:var(--gray-500); margin-bottom:8px;">Total Complaints</div><div id="ovTotal" style="font-size:2.2rem; font-weight:800; color:var(--gray-900);">0</div></div>
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none;"><div style="font-size:0.85rem; color:var(--gray-500); margin-bottom:8px;">Resolved</div><div id="ovResolved" style="font-size:2.2rem; font-weight:800; color:#10b981;">0</div></div>
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none;"><div style="font-size:0.85rem; color:var(--gray-500); margin-bottom:8px;">In Progress</div><div id="ovProgress" style="font-size:2.2rem; font-weight:800; color:#f59e0b;">0</div></div>
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none;"><div style="font-size:0.85rem; color:var(--gray-500); margin-bottom:8px;">Fresh (New)</div><div id="ovFresh" style="font-size:2.2rem; font-weight:800; color:#64748b;">0</div></div>
    </div>
    <div style="max-width:500px; margin: 0 auto;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>
  
  <!-- Department View -->
  <div id="analyticsDeptView" style="display:none; background:white; padding:24px; border-radius:var(--radius-xl); box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);">
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:24px; margin-bottom: 40px;">
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none; border-top:4px solid #2563eb;"><div style="font-size:0.9rem; color:var(--gray-500); margin-bottom:8px;">Road</div><div id="dpRoad" style="font-size:2.2rem; font-weight:800; color:var(--gray-900);">0</div></div>
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none; border-top:4px solid #d97706;"><div style="font-size:0.9rem; color:var(--gray-500); margin-bottom:8px;">Street Light</div><div id="dpStreet" style="font-size:2.2rem; font-weight:800; color:var(--gray-900);">0</div></div>
      <div class="card" style="padding:24px; text-align:center; border:1px solid var(--gray-200); box-shadow:none; border-top:4px solid #dc2626;"><div style="font-size:0.9rem; color:var(--gray-500); margin-bottom:8px;">Traffic</div><div id="dpTraffic" style="font-size:2.2rem; font-weight:800; color:var(--gray-900);">0</div></div>
    </div>
    <div style="max-width:500px; margin: 0 auto;">
      <canvas id="deptChart"></canvas>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
<script src="database.js"></script>
<script src="script.js"></script>
</body>
</html>
