# AquaGuard AI — Environment Configuration Template
# AWS Environmental Hacks Hackathon

PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aquaguard_db
PGHOST=localhost
PGPORT=5433
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=aquaguard_db
PGSSL=false

# Roboflow Pre-Trained AI Model Configuration
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_API_KEY
ROBOFLOW_MODEL_ID=water-pollution-6ekuv-iqw6f/1
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_CONFIDENCE_THRESHOLD=0.30

# Mode configuration
DEMO_MODE=false

# AWS Cloud Services (Optional for Local Development, Required for AWS Cloud Deployment)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-aquaguard-complaints-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:aquaguard-officer-alerts

# Email Notification Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
